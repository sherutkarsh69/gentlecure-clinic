---
import BlogCard from './BlogCard.astro';
import { articles } from '../data/articles.js';

// Show first 3 articles on homepage
const recentArticles = articles.slice(0, 3);
---

<section class="latest-articles section">
  <div class="container">
    <div class="section-header reveal">
      <div>
        <span class="section-badge">Health Tips & News</span>
        <h2 class="section-title" style="text-align: left; margin-bottom: 0.5rem;">Latest From Our Blog</h2>
        <p class="section-subtitle" style="text-align: left; margin: 0; max-width: 600px;">
          Expert advice and insights on natural healing, wellness, and homeopathic care.
        </p>
      </div>
      <a href="/blog" class="btn btn-secondary view-all-btn">
        View All Articles <span class="arrow">&rarr;</span>
      </a>
    </div>

    <div class="articles-grid">
      {recentArticles.map((article, index) => (
        <BlogCard 
          title={article.title}
          excerpt={article.excerpt}
          date={article.date}
          category={article.category}
          slug={article.slug}
          delay={index * 100}
        />
      ))}
    </div>
    
    <!-- Mobile view all button -->
    <div class="mobile-cta reveal">
      <a href="/blog" class="btn btn-secondary">
        View All Articles <span class="arrow">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .latest-articles {
    background: var(--cream);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3.5rem;
  }

  .section-badge {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: var(--white);
    color: var(--primary);
    border-radius: var(--radius);
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1rem;
    box-shadow: var(--shadow-sm);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .arrow {
    transition: transform 0.3s ease;
  }
  
  .btn:hover .arrow {
    transform: translateX(4px);
  }

  .mobile-cta {
    display: none;
    text-align: center;
    margin-top: 2rem;
  }

  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    
    /* Hide the 3rd one on tablet to keep grid even */
    .articles-grid > :nth-child(3) {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    
    .view-all-btn {
      display: none;
    }
    
    .mobile-cta {
      display: block;
    }
    
    .articles-grid {
      grid-template-columns: 1fr;
    }
    
    .articles-grid > :nth-child(3) {
      display: flex; /* Show it again on mobile */
    }
  }
</style>
