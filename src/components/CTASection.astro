---
export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Ready to Start Your Healing Journey?",
  description = "Book a consultation with Dr. Isha Tonk to experience the power of natural, personalized homeopathic care."
} = Astro.props;

const phoneNumber = "+91 9718102615";
---

<section class="cta-section section">
  <div class="cta-bg">
    <div class="cta-shape"></div>
  </div>
  
  <div class="container relative">
    <div class="cta-content glass reveal">
      <h2>{title}</h2>
      <p>{description}</p>
      
      <div class="cta-buttons">
        <a href="/book-appointment" class="btn btn-primary">
          Book Appointment
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href={`tel:${phoneNumber.replace(/\s+/g, '')}`} class="btn btn-secondary white-btn">
          Call {phoneNumber}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    background: var(--primary-dark);
    padding: 6rem 0;
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .cta-shape {
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
  }

  .relative {
    position: relative;
    z-index: 1;
  }

  .cta-content {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4rem 2rem;
    text-align: center;
    border-radius: var(--radius-xl);
    max-width: 800px;
    margin: 0 auto;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  h2 {
    color: var(--white);
    font-size: 2.25rem;
    margin-bottom: 1.25rem;
  }

  p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.1rem;
    max-width: 540px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .white-btn {
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--white);
  }

  .white-btn:hover {
    background: var(--white);
    color: var(--primary-dark);
    border-color: var(--white);
  }

  @media (max-width: 768px) {
    .cta-content {
      padding: 3rem 1.5rem;
    }
    
    h2 {
      font-size: 1.85rem;
    }
    
    .cta-buttons {
      flex-direction: column;
      gap: 1rem;
    }
    
    .btn {
      width: 100%;
    }
  }
</style>
