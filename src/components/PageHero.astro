---
export interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  align?: 'center' | 'left';
}

const { title, subtitle, badge, align = 'center' } = Astro.props;
---

<section class={`page-hero align-${align}`}>
  <div class="hero-bg">
    <div class="hero-shape shape-1"></div>
    <div class="hero-shape shape-2"></div>
  </div>
  
  <div class="container hero-content">
    {badge && <span class="badge reveal">{badge}</span>}
    <h1 class="title reveal delay-100"><span class="gradient-text">{title}</span></h1>
    {subtitle && <p class="subtitle reveal delay-200">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: 9rem 0 5rem;
    background: linear-gradient(180deg, var(--primary-pale) 0%, var(--cream) 100%);
    overflow: hidden;
  }

  .align-center {
    text-align: center;
  }

  .align-left {
    text-align: left;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.5;
  }

  .shape-1 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, var(--primary-pale) 0%, transparent 70%);
    top: -100px;
    right: -100px;
  }

  .shape-2 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(201, 168, 108, 0.15) 0%, transparent 70%);
    bottom: -50px;
    left: -50px;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .align-center .hero-content {
    align-items: center;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: var(--white);
    color: var(--primary);
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .title {
    font-size: 3rem;
    color: var(--dark);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .subtitle {
    color: var(--text-light);
    font-size: 1.15rem;
    max-width: 650px;
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 7.5rem 0 4rem;
    }
    
    .title {
      font-size: 2.25rem;
    }
    
    .subtitle {
      font-size: 1.05rem;
    }
  }
</style>
