---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

const phoneNumber = "+91 9718102615";
---

<Layout title="Contact Us" description="Get in touch with GentleCure Homeopathic Clinic.">
  <Navbar />
  <main>
    <PageHero 
      title="Get in Touch" 
      subtitle="We are here to answer your questions and help you schedule an appointment."
      badge="Contact Us"
    />

    <section class="contact-section section">
      <div class="container">
        <div class="contact-grid">
          
          <div class="contact-info reveal-left">
            <h2>Clinic Details</h2>
            <p class="info-desc">Reach out to us for appointments, inquiries, or any other assistance you might need.</p>
            
            <div class="info-card">
              <div class="info-icon">📍</div>
              <div class="info-text">
                <h3>Visit Us</h3>
                <p>B-139, near Unique Lab Pathology,<br>B-Block, Lohia Nagar,<br>Ghaziabad, UP 201001</p>
              </div>
            </div>
            
            <div class="info-card">
              <div class="info-icon">📞</div>
              <div class="info-text">
                <h3>Call Us</h3>
                <p><a href={`tel:${phoneNumber.replace(/\s+/g, '')}`}>{phoneNumber}</a></p>
              </div>
            </div>
            
            <div class="info-card">
              <div class="info-icon">✉️</div>
              <div class="info-text">
                <h3>Email Us</h3>
                <p><a href="mailto:appointments@gentlecure.online">appointments@gentlecure.online</a></p>
              </div>
            </div>
            
            <div class="info-card">
              <div class="info-icon">🕒</div>
              <div class="info-text">
                <h3>Opening Hours</h3>
                <p>Monday - Saturday:<br>10:30 AM - 1:30 PM & 5:30 PM - 8:30 PM</p>
                <p style="margin-top:0.5rem">Sunday:<br>10:30 AM - 1:30 PM</p>
              </div>
            </div>
          </div>

          <div class="contact-form-wrapper reveal-right">
            <div class="form-card">
              <h2>Send a Message</h2>
              <p>Fill out the form below and we will get back to you shortly.</p>
              
              <form action="https://formsubmit.co/your-email@example.com" method="POST" class="contact-form">
                <!-- Disable Captcha -->
                <input type="hidden" name="_captcha" value="false">
                <input type="hidden" name="_subject" value="New Contact Inquiry - GentleCure">
                
                <div class="form-group">
                  <label for="name">Full Name</label>
                  <input type="text" id="name" name="name" required placeholder="John Doe">
                </div>
                
                <div class="form-row">
                  <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="tel" id="phone" name="phone" required placeholder="1234567890">
                  </div>
                  <div class="form-group">
                    <label for="email">Email (Optional)</label>
                    <input type="email" id="email" name="email" placeholder="john@example.com">
                  </div>
                </div>
                
                <div class="form-group">
                  <label for="message">Your Message</label>
                  <textarea id="message" name="message" rows="5" required placeholder="How can we help you?"></textarea>
                </div>
                
                <button type="submit" class="btn btn-primary submit-btn">
                  Send Message
                </button>
              </form>
            </div>
          </div>

        </div>
        
        <!-- Google Map Embedded -->
        <div class="map-container reveal">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d112108.97341381335!2d77.3484214!3d28.6631853!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390cf1a3648e89ad%3A0xe54ef9a42fbd0816!2sGentlecure!5e0!3m2!1sen!2sin!4v1715694294025!5m2!1sen!2sin" 
            width="100%" 
            height="450" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .contact-section {
    background: var(--white);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    margin-bottom: 5rem;
  }

  .contact-info h2, .form-card h2 {
    font-size: 2rem;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }

  .info-desc {
    color: var(--text-light);
    margin-bottom: 2.5rem;
    font-size: 1.05rem;
  }

  .info-card {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 2rem;
    align-items: flex-start;
  }

  .info-icon {
    width: 50px;
    height: 50px;
    background: var(--primary-pale);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .info-text h3 {
    font-family: var(--font-body);
    font-size: 1.15rem;
    color: var(--dark);
    margin-bottom: 0.5rem;
  }

  .info-text p {
    color: var(--text-light);
    line-height: 1.6;
  }

  .info-text a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
  }

  .info-text a:hover {
    text-decoration: underline;
  }

  .form-card {
    background: var(--white);
    padding: 3rem;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--gray-200);
  }

  .form-card p {
    color: var(--text-light);
    margin-bottom: 2rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  label {
    display: block;
    font-weight: 500;
    color: var(--dark);
    margin-bottom: 0.5rem;
  }

  input, textarea {
    width: 100%;
    padding: 1rem 1.25rem;
    border: 1px solid var(--gray-300);
    border-radius: var(--radius);
    background: #fdfdfd;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text);
    transition: var(--transition-fast);
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--primary);
    background: var(--white);
    box-shadow: 0 0 0 3px var(--primary-pale);
  }

  .submit-btn {
    width: 100%;
    margin-top: 1rem;
    padding: 1.25rem;
    font-size: 1.1rem;
  }

  .map-container {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .form-card {
      padding: 2rem;
    }
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
