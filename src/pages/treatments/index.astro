---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageHero from '../../components/PageHero.astro';
import TreatmentCard from '../../components/TreatmentCard.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';
import { treatments } from '../../data/treatments.js';
---

<Layout title="Treatments">
  <Navbar />
  <main>
    <PageHero 
      title="Healing Treatments" 
      subtitle="We offer comprehensive homeopathic treatments designed to address the root cause of your health concerns, not just the symptoms."
      badge="Our Expertise"
    />

    <section class="treatments-section section">
      <div class="container">
        <div class="treatments-grid">
          {treatments.map((treatment, index) => (
            <TreatmentCard 
              title={treatment.title}
              description={treatment.description}
              icon={treatment.icon}
              slug={treatment.slug}
              delay={index * 100}
            />
          ))}
        </div>
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</Layout>

<style>
  .treatments-section {
    background: var(--cream);
  }

  .treatments-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 1024px) {
    .treatments-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .treatments-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
